# Files read inside Linux containers keep LF line endings on every checkout, including
# Windows with core.autocrlf=true: a CRLF Dockerfile breaks its heredoc (`EOF\r`).
Dockerfile          text eol=lf
.dockerignore       text eol=lf
*.lock              text eol=lf
requirements*.txt   text eol=lf
*.yml               text eol=lf
*.yaml              text eol=lf
*.toml              text eol=lf
*.conf              text eol=lf
*.sh                text eol=lf
*.mjs               text eol=lf
dashboard/package*.json text eol=lf
